#!/usr/bin/env bash
case "$1" in
  -t) exit "$(cat "$STUB_DIR/sshd-t-rc" 2>/dev/null || echo 0)" ;;
  -T)
    if [ -f "${HELPOUPOU_SSHD_DROPIN_DIR:-/nonexistent}/00-helpoupou.conf" ] && [ ! -f "$STUB_DIR/sshd-overridden" ]; then
      printf 'passwordauthentication no\npermitrootlogin prohibit-password\n'
    elif [ -f "$STUB_DIR/sshd" ]; then
      cat "$STUB_DIR/sshd"
    else
      exit 1
    fi
    ;;
esac
